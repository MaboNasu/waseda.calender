# WasedaCalendar AI Office — 環境変数
# このファイルをコピーして .env を作り、実際の値を埋めてください。
# .env はコミットしないこと（リポジトリ直下の .gitignore で ai-office/.env を除外済み）。

DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- 任意の安全設定（未設定でも動作しますが、既定値がそれぞれ適用されます） ----

# 月間のAPI利用予算上限(USD)。超過すると新規会議の開始を拒否します。既定: 5
# MONTHLY_BUDGET_USD=5

# 1回の会議あたりの概算コストがこれ(USD)を超える場合、開始前にDiscord上で確認を求めます。既定: 0.5
# COST_CONFIRM_THRESHOLD_USD=0.5

# 1日あたりに開始できる会議の最大回数。既定: 5
# DAILY_MEETING_LIMIT=5
