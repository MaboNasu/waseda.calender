# X(旧Twitter)自動投稿用の認証情報。
# 実際の値は絶対にコミットしないこと。このファイルをコピーして .env を作り、値を埋めてください。
# 発行手順は docs/x-automation-setup.md を参照。
# GitHub Actions上ではこれらはSecretsから環境変数として渡されるため、.envファイルは不要です
# (.envはローカルでの動作確認用)。

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 運用モード(ローカル確認用。GitHub ActionsではVariablesで設定します)
X_AUTOMATION_ENABLED=true
X_DRY_RUN=true
