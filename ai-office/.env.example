# WasedaCalendar AI Office — 環境変数
# このファイルをコピーして .env を作り、実際の値を埋めてください。
# .env はコミットしないこと（リポジトリ直下の .gitignore で ai-office/.env を除外済み）。

DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Owner承認・却下・保留、続行/再試行/中止の操作を許可するDiscordユーザーID(必須)。
# これ以外のユーザーからの操作は無効になります(Constitution 13条)。
# 自分のDiscordユーザーIDの調べ方: Discordの設定 > 詳細設定 > 開発者モードをON
# → 自分のアイコンを右クリック → 「ユーザーIDをコピー」
OWNER_DISCORD_USER_ID=

# ---- 任意の安全設定（未設定でも動作しますが、既定値がそれぞれ適用されます） ----

# 月間のAPI利用予算上限(USD)。超過すると新規会議の開始を拒否します。既定: 5
# MONTHLY_BUDGET_USD=5

# OpenAI月間利用上限(USD)。唯一の主要有料コンポーネントのため別枠で管理します。既定: 3
# OPENAI_MONTHLY_BUDGET_USD=3

# 1会議あたりのAPIコスト上限(USD)。超過すると会議を強制中断します。既定: 1
# MAX_COST_PER_MEETING_USD=1

# 1回の会議あたりの概算コストがこれ(USD)を超える場合、開始前にDiscord上で確認を求めます。既定: 0.5
# COST_CONFIRM_THRESHOLD_USD=0.5

# 1日あたりに開始できる会議の最大回数。既定: 5
# DAILY_MEETING_LIMIT=5

# knowledge/配下のファイルが何日以上前の更新なら鮮度警告を付けるか。既定: 90
# KNOWLEDGE_STALE_DAYS=90

# ---- GitHub Issue自動起票(任意。両方設定した場合のみ有効) ----
# CEOが「採用」と決定し、Owner承認が不要(または承認済み)になった決定を
# GitHub Issueとして自動起票する。コード変更は一切自動化しない(起票のみ)。

# Issue作成権限を持つGitHub Personal Access Token(Fine-grained PATの場合、対象
# リポジトリへの "Issues: Read and write" 権限が必要)。
# GITHUB_TOKEN=

# Issueを作成する対象リポジトリ(形式: owner/repo)。例: MaboNasu/waseda.calender
# GITHUB_REPO=
